
# Chat Scholar — Example Configuration
# Copy this file to .env and configure your own credentials.
# Never commit your actual .env file.

# Groq API configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Authentication
# Generate these values using:
# python setup_v11_auth.py
CHAT_SCHOLAR_PASSWORD_HASH=
CHAT_SCHOLAR_SESSION_SECRET=

# Embedding backend
CHAT_SCHOLAR_EMBEDDING_BACKEND=onnx
